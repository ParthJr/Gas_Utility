# ========================================================
# StayFlow PG Management — Production Configuration Template
# ========================================================
APP_ENV=production
APP_NAME="StayFlow PG Management System"
APP_URL=https://stayflow.antideploy.app
APP_DEBUG=false

# ========================================================
# Supabase Connector Configuration (Recommended)
# ========================================================
# Supabase API Settings (Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Direct PostgreSQL Connection (Settings -> Database -> Connection Pooler)
SUPABASE_DB_HOST=aws-0-ap-south-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project
SUPABASE_DB_PASS=your-database-password

# Alternatively, single DATABASE_URL provided by AntiDeploy / Fly.io:
# DATABASE_URL=postgresql://postgres.your-project:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ========================================================
# MySQL / MariaDB Database Configuration (Alternative)
# ========================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stayflow
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ========================================================
# Mail Configuration (Optional)
# ========================================================
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@stayflow.antideploy.app
MAIL_FROM_NAME="StayFlow"
