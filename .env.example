# ========================================================
# StayFlow PG Management — Production Configuration Template
# ========================================================
APP_ENV=production
APP_NAME="StayFlow PG Management System"
APP_URL=https://stayflow.antideploy.app
APP_DEBUG=false

# Database Configuration (Set in AntiDeploy / Fly.io secrets if external)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stayflow
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Mail Configuration (Optional)
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@stayflow.antideploy.app
MAIL_FROM_NAME="StayFlow"

