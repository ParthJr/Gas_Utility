# ========================================================
# StayFlow PG Management SaaS — Environment Configuration Template
# ========================================================
APP_ENV=production
APP_NAME="StayFlow PG Management System"
APP_URL="https://stayflow.antideploy.app"
APP_DEBUG=false

# --- PRODUCTION MYSQL DATABASE CONFIGURATION ---
# For Fly.io, set via secrets:
#   fly secrets set DB_HOST=your-real-mysql-host DB_NAME=your-database-name DB_USER=your-database-user DB_PASS=your-database-password
# For Render / PaaS, add under Environment Variables.
DB_HOST=your-real-mysql-host
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASS=your-database-password
DB_PORT=3306
DB_CHARSET=utf8mb4

# Or connection URL:
# DATABASE_URL=mysql://user:password@host:3306/database_name
