# ========================================================
# StayFlow PG Management SaaS — Environment Configuration Template
# ========================================================
APP_ENV=production
APP_NAME="StayFlow PG Management System"
APP_URL="https://stayflow.antideploy.app"
APP_DEBUG=false

# --- MYSQL DATABASE CONFIGURATION ---
# For Fly.io, set these via CLI:
#   fly secrets set DB_HOST=your-mysql-host DB_NAME=your-db DB_USER=your-user DB_PASS=your-pass
# For Render / Docker, add them under Environment Variables.
DB_HOST=your-real-mysql-host
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASS=your-database-password
DB_PORT=3306
DB_CHARSET=utf8mb4

# Or connection URL:
# DATABASE_URL=mysql://user:password@host:3306/database_name

# --- SMTP MAIL CONFIGURATION (Optional) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=support@stayflow.antideploy.app
MAIL_FROM_NAME="StayFlow Support"
